# Required: keys issued by Storyblocks (https://developer.storyblocks.com/register for test keys)
STORYBLOCKS_PUBLIC_KEY=your_public_key
STORYBLOCKS_PRIVATE_KEY=your_private_key

# Optional: defaults used when a tool call omits user_id / project_id.
# Storyblocks requires both on search and download requests. Use opaque ids, not names or emails.
STORYBLOCKS_DEFAULT_USER_ID=
STORYBLOCKS_DEFAULT_PROJECT_ID=

# Optional overrides
# STORYBLOCKS_BASE_URL=https://api.storyblocks.com
# Seconds until a signed request's EXPIRES timestamp lapses (max allowed by Storyblocks: 36h = 129600)
# STORYBLOCKS_EXPIRES_SECONDS=300
# HTTP timeout in milliseconds
# STORYBLOCKS_TIMEOUT_MS=30000
